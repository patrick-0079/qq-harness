{
  "name": "qq-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:console": "vite --config apps/console/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/main.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "docs:dependencies": "node --import tsx scripts/plugin-dependencies.mjs",
    "check:dependencies": "node --import tsx scripts/plugin-dependencies.mjs --check",
    "portable:prepare": "node scripts/portable-qq.mjs prepare",
    "portable:check": "node scripts/portable-qq.mjs check",
    "migrate:settings": "node --import tsx tools/migrate-settings.ts",
    "live:check": "node --import tsx tools/preflight.ts",
    "start:live": "node scripts/start-live.mjs",
    "manage": "node manage.mjs",
    "desktop": "electron dist/desktop/main.mjs",
    "format": "prettier --write .",
    "build:extensions": "node scripts/build-extension-compat.mjs",
    "pretest": "node scripts/build-extension-compat.mjs",
    "pretypecheck": "node scripts/build-extension-compat.mjs",
    "predev:server": "node scripts/build-extension-compat.mjs",
    "predev": "node scripts/build-extension-compat.mjs",
    "test:v2-reference": "node scripts/build-extension-compat.mjs && node scripts/test-v2-reference.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@tanstack/react-query": "5.104.5",
    "antd": "6.6.8",
    "cordis": "3.18.1",
    "hono": "4.13.14",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "rolldown": "1.2.15",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
